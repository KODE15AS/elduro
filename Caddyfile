{
	email jorn@kode15.no
	on_demand_tls {
		ask http://kontroll-server:3200/tls-sjekk
	}
}

elduro.no, www.elduro.no {
	encode gzip
	# Backend serves the SPA (with index.html fallback) and the /ws/* upgrades.
	reverse_proxy web:8080
}

# Studio 15 (KODE15, repo ~/dev/studio15): landingsside + klasse-/
# prosjektdomener. Permanent domene studio15.cloud (beslutning 48, 31.08.2026).
# Sertifikater utstedes on-demand per vertsnavn (HTTP-01) og godkjennes av
# kontroll-serverens /tls-sjekk, slik at tilfeldige hostnavn fra
# internett-skannere ikke brenner Let's Encrypt-kvoten.
studio15.cloud, www.studio15.cloud {
	encode gzip
	tls {
		on_demand
	}
	root * /srv/studio15-landing
	file_server
}

*.studio15.cloud, *.*.studio15.cloud {
	tls {
		on_demand
	}
	reverse_proxy kontroll-server:3200
}

# kode15 midlertidig paa erbium.no (repo KODE15AS/wordpress-kode15-no):
# rot-domenet gaar rett til WordPress-containeren, www omdirigeres til rot.
# Byttes til kode15.no naar domenet frigis.
erbium.no {
	encode gzip
	reverse_proxy wordpress-kode15-no:80
}

www.erbium.no {
	redir https://erbium.no{uri} permanent
}
